<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema Escuro: fundo grafite. As cores de destaque (Accent*) são definidas pelo ThemeService. -->
    <SolidColorBrush x:Key="BgBrush" Color="#FF0D0F12" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF14171B" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF1C2026" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FF2A2F37" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFE7EBF0" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF97A1AF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF22C55E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF5B83D" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFEF4F4F" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#33F5B83D" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#28FFFFFF" />
</ResourceDictionary>
