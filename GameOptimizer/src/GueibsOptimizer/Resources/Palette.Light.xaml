<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema Claro. Sucesso/aviso/perigo mais escuros para manter contraste de texto sobre fundo claro (≥ 4.5:1). -->
    <SolidColorBrush x:Key="BgBrush" Color="#FFF3F5F8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFE9EDF2" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFD3D9E1" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF161B22" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF56606E" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF15803D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFA14D05" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC81E1E" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#26D97706" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#22000000" />
</ResourceDictionary>
