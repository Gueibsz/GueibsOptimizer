<UserControl x:Class="GueibsOptimizer.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
             xmlns:c="clr-namespace:GueibsOptimizer.Views.Controls"
             xmlns:m="clr-namespace:GueibsOptimizer.Models">
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Otimização Completa'}" />
            <TextBlock Style="{StaticResource SubtitleText}"
                       Text="{l:T 'Cada ajuste mostra o que faz e o risco. O estado é lido do sistema em tempo real; use Desfazer para voltar ao valor anterior.'}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Liberar RAM'}" /><c:InfoButton Title="{l:T 'Liberar RAM'}" Text="{x:Static m:UiHelp.RamClean}" Margin="0,-6,0,0" /></StackPanel>
                        <TextBlock Style="{StaticResource SubtitleText}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="RamStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                        <Button Content="{l:T 'Liberar agora'}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding CleanRamCommand}"
                                IsEnabled="{Binding IsCleaningRam, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsBoosterEnabled}"
                                      AutomationProperties.Name="Game Booster" />
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Game Booster'}" /><c:InfoButton Title="{l:T 'Game Booster'}" Text="{x:Static m:UiHelp.GameBooster}" Margin="0,-6,0,0" /></StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource SubtitleText}"
                                   Text="{l:T 'A cada 5 segundos, dá prioridade Alta (nunca Tempo Real) aos jogos da sua lista enquanto estiverem abertos.'}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="{l:T 'Editar lista de jogos'}" Command="{Binding OpenGamesListCommand}" /><c:InfoButton Title="{l:T 'Editar lista de jogos'}" Text="{x:Static m:UiHelp.GamesList}" /></StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Style="{StaticResource SectionText}"><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Title" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TweakCard}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
