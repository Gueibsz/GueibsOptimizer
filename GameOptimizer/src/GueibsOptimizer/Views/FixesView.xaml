<UserControl x:Class="GueibsOptimizer.Views.FixesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
             xmlns:c="clr-namespace:GueibsOptimizer.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Correções'}" />
                <c:InfoButton Title="{l:T 'Correções'}" Margin="4,0,0,0" VerticalAlignment="Center"
                              Text="{l:T 'Ações avulsas para problemas comuns. Os comandos exatos aparecem no cartão e na confirmação. As de risco Médio criam um ponto de restauração antes. O reset do Windows Update só renomeia as pastas (dá para voltar renomeando de novo) e sempre religa os serviços, mesmo se você cancelar. Cancelar para entre uma etapa e outra.'}" />
            </StackPanel>
            <TextBlock Style="{StaticResource SubtitleText}" Text="{l:T 'Rede, Windows Update, Microsoft Store e ícones. Para SFC e DISM, use a Manutenção.'}" />

            <ItemsControl ItemsSource="{Binding Cards}" Margin="-8,16,-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="8,0,8,16">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Button DockPanel.Dock="Right" Content="{l:T 'Executar'}" VerticalAlignment="Bottom"
                                            Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title, StringFormat='Executar {0}'}" />
                                    <TextBox Text="{Binding CommandText, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                             TextWrapping="Wrap" Margin="0,0,8,0" />
                                </DockPanel>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="RiskText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                        <TextBlock FontWeight="SemiBold" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Title" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SubtitleText}" FontSize="12" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Description" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:T 'Abrir Manutenção'}" Command="{Binding OpenMaintenanceCommand}" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{l:T 'SFC e DISM'}" />
                        <TextBlock Style="{StaticResource SubtitleText}" FontSize="12" Text="{l:T 'A verificação e o reparo dos arquivos do Windows (sfc /scannow e DISM /RestoreHealth) ficam na Manutenção, com saída ao vivo e Cancelar.'}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="{l:T 'Cancelar'}" Command="{Binding CancelCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Cancelar correção" />
                        <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Execução e resultado'}" />
                    </DockPanel>
                    <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,6">
                        <ProgressBar IsIndeterminate="True" Height="6" />
                        <TextBlock FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextMutedBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Status" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    </StackPanel>
                    <TextBlock FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource AccentTextBrush}" Margin="0,4,0,6"
                               Visibility="{Binding Summary, Converter={StaticResource NotEmptyToVisibility}}" AutomationProperties.Name="Resumo da correção" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Summary" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    <TextBlock Style="{StaticResource SubtitleText}" Text="{l:T 'Nenhuma correção executada nesta sessão.'}"
                               Visibility="{Binding Output, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}" />
                    <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Height="180"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Visibility="{Binding Output, Converter={StaticResource NotEmptyToVisibility}}"
                             AutomationProperties.Name="Saída da correção" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
