<Window x:Class="GueibsOptimizer.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
        Title="{l:T 'Gueibs Optimizer Overlay'}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="Cascadia Mono, Consolas"
        MouseLeftButtonDown="OnMouseDown">
    <Border x:Name="Root" CornerRadius="8" Padding="10,6" Background="{DynamicResource OverlayBackgroundBrush}" BorderThickness="1" BorderBrush="Transparent">
        <StackPanel>
            <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                       Visibility="{Binding ShowFps, Converter={StaticResource BoolToVisibility}}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="FpsText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
            <TextBlock FontSize="13" Foreground="{DynamicResource OverlayTextBrush}"
                       Visibility="{Binding ShowLows, Converter={StaticResource BoolToVisibility}}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="LowsText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
            <TextBlock FontSize="13" Foreground="{DynamicResource OverlayTextBrush}"
                       Visibility="{Binding ShowCpu, Converter={StaticResource BoolToVisibility}}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="CpuText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
            <TextBlock FontSize="13" Foreground="{DynamicResource OverlayTextBrush}"
                       Visibility="{Binding ShowGpu, Converter={StaticResource BoolToVisibility}}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="GpuText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
            <TextBlock Text="{l:T 'Arraste para posicionar'}" FontSize="11" Foreground="{DynamicResource OverlayNoteBrush}" FontFamily="Segoe UI"
                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
</Window>
