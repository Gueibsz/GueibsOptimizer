<UserControl x:Class="GueibsOptimizer.Views.WindowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
             xmlns:c="clr-namespace:GueibsOptimizer.Views.Controls"
             xmlns:m="clr-namespace:GueibsOptimizer.Models"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Manutenção'}" />
            <TextBlock Style="{StaticResource SubtitleText}"
                       Text="{l:T 'Revisão de integridade (CHKDSK, DISM, SFC), limpeza, programas de inicialização e limpeza semanal automática. Os ajustes de privacidade e IA estão em Otimizações.'}" />
            <!-- Revisão semanal de integridade (8.5) -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                                   AutomationProperties.Name="Última revisão" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="LastReviewText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Revisão semanal de integridade'}" />
                            <c:InfoButton Title="{l:T 'Revisão semanal de integridade'}" Margin="0,-6,0,0"
                                          Text="{l:T 'Recomendada uma vez por semana. Executa, nesta ordem: CHKDSK em modo leitura (sem /f, não altera o disco), DISM /RestoreHealth (repara a imagem do Windows usando o Windows Update) e SFC /scannow (troca arquivos de sistema corrompidos pela cópia boa). O DISM vem antes do SFC para o SFC usar a imagem já reparada. Leva de 10 a 30 minutos; dá para cancelar. Se o CHKDSK achar erros, o app oferece agendar o reparo na próxima inicialização, sempre com confirmação. Não é a mesma coisa que a Limpeza semanal automática.'}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource SubtitleText}" Text="{l:T 'Verifica o disco e os arquivos do Windows. Estimativa: 10 a 30 minutos.'}" />
                    <TextBlock FontSize="12" Margin="0,10,0,4" Foreground="{DynamicResource TextMutedBrush}" Text="{l:T 'Comandos que serão executados:'}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:T 'Copiar'}" Command="{Binding CopyTextCommand}" CommandParameter="{Binding WeeklyCommandText}"
                                VerticalAlignment="Top" Margin="8,0,0,0" AutomationProperties.Name="Copiar comandos da revisão" />
                        <TextBox Text="{Binding WeeklyCommandText, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 TextWrapping="Wrap" AutomationProperties.Name="Comandos da revisão" />
                    </DockPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <CheckBox Content="{l:T 'Criar ponto de restauração antes'}" IsChecked="{Binding CreateRestorePointFirst}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,8" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{l:T 'Iniciar revisão'}" Command="{Binding RunWeeklyReviewCommand}" Margin="0,0,10,8"
                                AutomationProperties.Name="Iniciar revisão" />
                        <Button Style="{StaticResource DangerButton}" Content="{l:T 'Cancelar'}" Command="{Binding CancelToolCommand}" Margin="0,0,10,8"
                                Visibility="{Binding IsToolRunning, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Cancelar ferramenta" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Outras ferramentas -->
            <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Outras ferramentas'}" Margin="0,18,0,8" />
            <ItemsControl ItemsSource="{Binding ToolCards}" Margin="-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="8,0,8,16">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Button DockPanel.Dock="Right" Content="{l:T 'Executar'}" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RunToolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title, StringFormat='Executar {0}'}" />
                                    <Button DockPanel.Dock="Right" Content="{l:T 'Copiar'}" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding CommandText}" AutomationProperties.Name="{Binding Title, StringFormat='Copiar comando {0}'}" />
                                    <TextBox Text="{Binding CommandText, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                             TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Estimate" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                        <TextBlock FontWeight="SemiBold" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Title" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SubtitleText}" FontSize="12" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Description" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Progresso, log e resumo -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="{l:T 'Cancelar'}" Command="{Binding CancelToolCommand}"
                                Visibility="{Binding IsToolRunning, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Cancelar execução" />
                        <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Execução e resultado'}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource SubtitleText}" Text="{l:T 'Nenhuma ferramenta executada nesta sessão.'}"
                               Visibility="{Binding ToolOutput, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}" />
                    <StackPanel Visibility="{Binding IsToolRunning, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,6">
                        <ProgressBar IsIndeterminate="True" Height="6" />
                        <TextBlock FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextMutedBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="ToolStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    </StackPanel>
                    <TextBlock FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource AccentTextBrush}" Margin="0,4,0,6"
                               Visibility="{Binding ToolSummary, Converter={StaticResource NotEmptyToVisibility}}" AutomationProperties.Name="Resumo da manutenção" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="ToolSummary" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    <ItemsControl ItemsSource="{Binding ToolSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,2">
                                    <Run FontWeight="SemiBold"><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Title" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run>
                                    <Run Text=" · " />
                                    <Run Foreground="{DynamicResource AccentTextBrush}"><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Outcome" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run>
                                    <Run Text=" — " />
                                    <Run><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Summary" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{l:T 'Agendar reparo do disco na próxima inicialização'}" Command="{Binding ScheduleChkdskRepairCommand}" HorizontalAlignment="Left"
                            Margin="0,8,0,0" Visibility="{Binding CanScheduleChkdsk, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Agendar reparo do disco" />
                    <TextBox Text="{Binding ToolOutput, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="0,10,0,0"
                             Height="180" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" TextChanged="OnToolOutputChanged"
                             Visibility="{Binding ToolOutput, Converter={StaticResource NotEmptyToVisibility}}" AutomationProperties.Name="Saída da ferramenta" />
                </StackPanel>
            </Border>


            <!-- Limpeza -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Limpeza'}" />
                    <TextBlock Style="{StaticResource SubtitleText}" Margin="0,0,0,10"
                               Text="{l:T 'O tamanho é calculado antes e você confirma. A pasta Prefetch nunca é apagada.'}" />
                    <ItemsControl ItemsSource="{Binding CleanupOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding Name}" />
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock FontWeight="SemiBold" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Name" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                        <TextBlock Style="{StaticResource SubtitleText}" FontSize="12" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Description" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextMutedBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="SizeText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{l:T 'Analisar'}" Command="{Binding AnalyzeCommand}"
                                IsEnabled="{Binding IsCleaning, Converter={StaticResource InverseBool}}" />
                        <c:InfoButton Title="{l:T 'Analisar'}" Text="{x:Static m:UiHelp.CleanupAnalyze}" />
                        <Button Content="{l:T 'Limpar selecionados'}" Style="{StaticResource PrimaryButton}" Margin="4,0,0,0"
                                Command="{Binding CleanCommand}" IsEnabled="{Binding IsCleaning, Converter={StaticResource InverseBool}}" />
                        <c:InfoButton Title="{l:T 'Limpar selecionados'}" Text="{x:Static m:UiHelp.CleanupRun}" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="CleanupStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    </StackPanel>
                    <!-- 9.2: Limpeza de Disco do Windows (cleanmgr) -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold" Text="{l:T 'Limpeza de Disco do Windows'}" VerticalAlignment="Center" />
                                <c:InfoButton Title="{l:T 'Limpeza de Disco do Windows'}"
                                              Text="{l:T 'Usa a ferramenta nativa cleanmgr. Escolher categorias (cleanmgr /sageset:64) abre a janela do Windows para marcar o que limpar e não apaga nada. Executar (cleanmgr /sagerun:64) limpa as categorias escolhidas. Ela alcança itens que o app não limpa, como arquivos de atualizações antigas.'}" />
                            </StackPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="{l:T 'Escolher categorias'}" Command="{Binding RunWindowsDiskCleanupCommand}" CommandParameter="set" Margin="0,0,8,0"
                                        AutomationProperties.Name="Escolher categorias da Limpeza de Disco" />
                                <Button Content="{l:T 'Executar'}" Command="{Binding RunWindowsDiskCleanupCommand}" CommandParameter="run" Margin="0,0,12,0"
                                        AutomationProperties.Name="Executar a Limpeza de Disco" />
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="CleanMgrStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Inicialização -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{l:T 'Atualizar'}" Command="{Binding RefreshStartupCommand}" />
                            <c:InfoButton Title="{l:T 'Lista de inicialização'}" Text="{x:Static m:UiHelp.StartupList}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Inicialização limpa'}" />
                            <c:InfoButton Title="{l:T 'Desativar e reativar'}" Text="{x:Static m:UiHelp.StartupToggle}" Margin="0,-6,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource SubtitleText}" Margin="0,0,0,10"
                               Text="{l:T 'Nada é apagado: os itens são desativados como no Gerenciador de Tarefas e podem ser reativados aqui ou na aba Restauração. Tarefas internas do Windows não são listadas.'}" />
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="StartupStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    <ItemsControl ItemsSource="{Binding StartupItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock FontWeight="SemiBold">
                                                <Run ><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Name" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run>
                                                <Run Text="{Binding PublisherText, Mode=OneWay, StringFormat=' · {0}'}" FontWeight="Normal"
                                                     Foreground="{DynamicResource TextMutedBrush}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Command" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="SourceText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{l:T 'Desativar'}" Style="{StaticResource DangerButton}"
                                                    Visibility="{Binding Enabled, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{l:T 'Reativar'}"
                                                    Visibility="{Binding Enabled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                                    Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Defender -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Exclusão no Microsoft Defender'}" />
                    <TextBlock Style="{StaticResource SubtitleText}"
                               Text="{l:T 'Opcional. Adiciona apenas a pasta do Gueibs Optimizer às exclusões; o Defender, o Firewall e o UAC nunca são desligados.'}" />
                    <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,8,0,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="AppFolder" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource AccentTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="DefenderStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{l:T 'Adicionar exclusão'}" Command="{Binding AddDefenderExclusionCommand}"
                                Visibility="{Binding HasDefenderExclusion, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <Button Content="{l:T 'Remover exclusão'}" Style="{StaticResource DangerButton}" Command="{Binding RemoveDefenderExclusionCommand}"
                                Visibility="{Binding HasDefenderExclusion, Converter={StaticResource BoolToVisibility}}" />
                        <c:InfoButton Title="{l:T 'Exclusão no Defender'}" Text="{x:Static m:UiHelp.DefenderExclusion}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Limpeza semanal automática (tarefa weekly) -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsWeeklyEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding IsWeeklyBusy, Converter={StaticResource InverseBool}}"
                                  AutomationProperties.Name="Limpeza semanal automática" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Limpeza semanal automática'}" />
                            <c:InfoButton Title="{l:T 'Limpeza semanal automática'}" Text="{x:Static m:UiHelp.Weekly}" Margin="0,-6,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource SubtitleText}"
                               Text="{l:T 'Todo domingo às 20h: limpa temporários e caches de shader, libera RAM e mostra um resumo em notificação. Não verifica o disco nem os arquivos do Windows (isso é a revisão de integridade acima).'}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
