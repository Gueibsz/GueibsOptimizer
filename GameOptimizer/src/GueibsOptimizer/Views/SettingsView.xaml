<UserControl x:Class="GueibsOptimizer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
             xmlns:c="clr-namespace:GueibsOptimizer.Views.Controls">
    <UserControl.Resources>
        <!-- Bolinha de cor reutilizada nas listas de destaque e de cor do ícone. -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" Width="40" Height="40" CornerRadius="20" BorderThickness="2" BorderBrush="Transparent">
                            <Border Margin="3" CornerRadius="15" Background="{Binding Brush}">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding CheckBrush}"
                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Configurações'}" />
            <TextBlock Style="{StaticResource SubtitleText}" Text="{l:T 'Preferências do Gueibs Optimizer. Tudo é aplicado na hora e salvo automaticamente.'}" />

            <!-- Inicialização -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Inicialização e privilégios'}" />
                        <c:InfoButton Title="{l:T 'Como o Gueibs Optimizer usa o administrador'}" Margin="0,-6,0,0"
                                      Text="{l:T 'O app sempre roda como administrador, porque altera registro do sistema, serviços, plano de energia e tarefas agendadas. Ao abrir, o Windows mostra o aviso do UAC; se você recusar, o app explica e fecha. Ele não inicia sozinho com o Windows: só abre quando você abrir.'}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SubtitleText}" Margin="0,4,0,0"
                               Text="{l:T 'Sempre abre como administrador. O app não inicia com o Windows: abra pelo atalho quando quiser usar.'}" />
                </StackPanel>
            </Border>

            <!-- Idioma -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Idioma'}" />
                        <c:InfoButton Title="{l:T 'Idioma'}" Margin="0,-6,0,0"
                                      Text="{l:T 'Idioma da interface. A troca é imediata, sem reiniciar. Textos ainda sem tradução aparecem em português.'}" />
                    </StackPanel>
                    <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Name"
                              SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                              AutomationProperties.Name="Idioma" />
                </StackPanel>
            </Border>

            <!-- Saudação -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Seu nome no Painel'}" />
                        <c:InfoButton Title="{l:T 'Seu nome no Painel'}" Margin="0,-6,0,0"
                                      Text="{l:T 'Nome usado na saudação do Painel (&quot;Olá, nome!&quot;). Deixe vazio para usar o nome do seu usuário do Windows. Fica salvo só em settings.json, no seu PC.'}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="240" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                 AutomationProperties.Name="Seu nome no Painel" />
                        <Button Content="{l:T 'Salvar'}" Margin="10,0,0,0" Command="{Binding SaveDisplayNameCommand}" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="DisplayNameStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Ponto de restauração (opcional) -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CreateRestorePoints}" VerticalAlignment="Center"
                              AutomationProperties.Name="Criar ponto de restauração antes de mudanças" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Criar ponto de restauração antes de mudanças'}" />
                            <c:InfoButton Title="{l:T 'Ponto de restauração'}" Margin="0,-6,0,0"
                                          Text="{l:T 'Ligado (recomendado): o Boost, os níveis de desempenho, os perfis, o Debloat, a formatação guiada e as correções de risco Médio criam um ponto de restauração do Windows antes de mudar algo. Desligado: as mudanças são feitas direto, mais rápido. Mesmo desligado, cada ajuste continua com o próprio desfazer na aba Restauração; o ponto de restauração é uma camada extra de segurança. O botão Criar ponto do Painel e a opção da revisão de integridade continuam funcionando.'}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SubtitleText}" FontSize="12"
                                   Text="{l:T 'Recomendado deixar ligado. Cada ajuste continua tendo seu próprio desfazer.'}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Aparência -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Aparência'}" />
                        <c:InfoButton Title="{l:T 'Aparência'}" Margin="0,-6,0,0"
                                      Text="{l:T 'Muda só as cores do Gueibs Optimizer; nada no Windows é alterado. A escolha fica em %AppData%\\GueibsOptimizer\\settings.json. Textos na cor de destaque são ajustados automaticamente para manter contraste legível (mínimo 4,5:1) no tema escolhido.'}" />
                    </StackPanel>

                    <TextBlock Text="{l:T 'Tema'}" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <ItemsControl ItemsSource="{Binding ThemeOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="Theme" Margin="0,0,10,8" Cursor="Hand"
                                             AutomationProperties.Name="{Binding Label}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Bd" Width="210" Padding="12,10" CornerRadius="8" BorderThickness="1"
                                                    Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Label" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Description" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{l:T 'Cor de destaque'}" FontWeight="SemiBold" Margin="0,10,0,6" />
                    <ItemsControl ItemsSource="{Binding Swatches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Cor de destaque {0}'}"
                                        Command="{Binding DataContext.ChooseAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                               </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{l:T 'Personalizada (HEX):'}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Width="120" Text="{Binding CustomHex, UpdateSourceTrigger=PropertyChanged}" MaxLength="7"
                                 FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Cor personalizada em HEX" />
                        <Button Content="{l:T 'Aplicar'}" Margin="10,0,0,0" Command="{Binding ApplyCustomHexCommand}" IsDefault="False" />
                        <Button Content="{l:T 'Restaurar padrão'}" Margin="10,0,0,0" Command="{Binding ResetAppearanceCommand}" />
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"
                               Visibility="{Binding HexError, Converter={StaticResource NotEmptyToVisibility}}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="HexError" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>

                    <!-- Prévia -->
                    <Border Margin="0,14,0,0" Padding="14" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Prévia'}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Content="{l:T 'Botão principal'}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                <Button Content="{l:T 'Secundário'}" Margin="0,0,8,8" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,8"
                                          AutomationProperties.Name="Exemplo de chave" />
                                <TextBlock Text="{l:T 'Texto em destaque'}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,8,8" />
                            </WrapPanel>
                            <ProgressBar Value="64" Maximum="100" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource SubtitleText}" FontSize="11.5" Margin="0,10,0,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="ContrastText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
