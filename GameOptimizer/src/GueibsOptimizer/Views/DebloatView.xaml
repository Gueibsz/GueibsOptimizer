<UserControl x:Class="GueibsOptimizer.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
             xmlns:c="clr-namespace:GueibsOptimizer.Views.Controls"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <!-- Uma linha de app: seleção (só se removível), nome, pacote, tamanho, status e botão de info. -->
        <DataTemplate x:Key="AppRow">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,7">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsSelected}" Margin="0,0,12,0"
                              VerticalAlignment="Center" IsEnabled="{Binding IsRemovable}"
                              Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibility}}"
                              AutomationProperties.Name="{Binding Name, StringFormat='Marcar {0} para remover'}" />
                    <c:InfoButton DockPanel.Dock="Right" Title="{Binding Name}" Text="{Binding InfoText}" ShortTip="{l:T 'Por que está nesta categoria'}" />
                    <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentTextBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Status" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="SizeText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Name" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="PackageName" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Debloat'}" />
            <TextBlock Style="{StaticResource SubtitleText}"
                       Text="{l:T 'Remova apps que vieram com o Windows e você não usa. Itens protegidos aparecem bloqueados com o motivo; itens fora do catálogo nunca são removidos. Antes de remover, um ponto de restauração é criado.'}" />

            <!-- Ações -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="{l:T 'Atualizar lista'}" Command="{Binding LoadCommand}" Margin="0,0,8,8"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <TextBlock Text="{l:T 'Predefinições:'}" VerticalAlignment="Center" Margin="8,0,8,8" />
                        <Button Content="{l:T 'Leve'}" Command="{Binding ApplyPresetCommand}" CommandParameter="Leve" Margin="0,0,8,8" />
                        <Button Content="{l:T 'Equilibrado'}" Command="{Binding ApplyPresetCommand}" CommandParameter="Equilibrado" Margin="0,0,8,8" />
                        <Button Content="{l:T 'Agressivo (avançado)'}" Style="{StaticResource DangerButton}" Command="{Binding ApplyPresetCommand}" CommandParameter="Agressivo" Margin="0,0,8,8" />
                        <c:InfoButton Title="{l:T 'Predefinições'}" Margin="0,0,8,8"
                                      Text="{l:T 'Leve: só apps claramente dispensáveis (Clipchamp, Paciência, Notícias, Clima, Obter Ajuda, Dicas, Hub de Comentários, atalho do Office). Equilibrado: todos os apps \'Seguro remover\'. Agressivo: também os \'Opcionais\' (Xbox, Game Bar, Phone Link, Teams, Widgets...) e pede confirmação dupla. As predefinições só marcam a lista: nada é removido sem você clicar em Remover e confirmar.'}" />
                        <Button Content="{l:T 'Limpar seleção'}" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IncludeProvisioned}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Remover também para novos usuários" />
                        <TextBlock Text="{l:T 'Remover também para novos usuários (provisionado)'}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <c:InfoButton Title="{l:T 'Remover para novos usuários'}"
                                      Text="{l:T 'Além de remover da sua conta, remove o pacote \'provisionado\', que o Windows instala em cada conta nova (Remove-AppxProvisionedPackage). Desmarcado por padrão: contas novas continuariam recebendo os apps. Mais difícil de desfazer.'}" />
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding ProvisionedNote, Converter={StaticResource NotEmptyToVisibility}}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="ProvisionedNote" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{l:T 'Remover selecionados'}" Style="{StaticResource PrimaryButton}" Command="{Binding RemoveSelectedCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <c:InfoButton Title="{l:T 'Remover selecionados'}"
                                      Text="{l:T 'Mostra um resumo e pede confirmação (e uma segunda confirmação se houver apps Opcionais), cria um ponto de restauração e remove com Remove-AppxPackage. Cada remoção fica registrada na aba Restauração, de onde dá para reinstalar pela Microsoft Store. Remover apps não é 100% reversível (risco Médio): configurações dos apps podem se perder.'}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Status" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding Report, Converter={StaticResource NotEmptyToVisibility}}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Report" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                </StackPanel>
            </Border>

            <!-- Listas -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Seguro remover'}" Foreground="{DynamicResource SuccessBrush}" />
                    <ItemsControl ItemsSource="{Binding SafeItems}" ItemTemplate="{StaticResource AppRow}" />
                    <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Opcional (avalie antes)'}" Foreground="{DynamicResource WarningBrush}" Margin="0,18,0,8" />
                    <ItemsControl ItemsSource="{Binding OptionalItems}" ItemTemplate="{StaticResource AppRow}" />
                    <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Não remover / protegido'}" Foreground="{DynamicResource DangerBrush}" Margin="0,18,0,8" />
                    <ItemsControl ItemsSource="{Binding ProtectedItems}" ItemTemplate="{StaticResource AppRow}" />
                    <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Não classificados (não são removidos)'}" Margin="0,18,0,8" />
                    <ItemsControl ItemsSource="{Binding UnclassifiedItems}" ItemTemplate="{StaticResource AppRow}" />
                </StackPanel>
            </Border>

            <!-- Extras -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Extras de privacidade e limpeza visual'}" />
                    <TextBlock Style="{StaticResource SubtitleText}" Margin="0,0,0,8"
                               Text="{l:T 'Ajustes reversíveis (também aparecem em Otimizações e na Restauração).'}" />
                    <ItemsControl ItemsSource="{Binding Extras}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,8">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="StatusText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                            <Button Content="{l:T 'Aplicar'}" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}"
                                                    Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                                    IsEnabled="{Binding IsApplicable}" />
                                            <Button Content="{l:T 'Desfazer'}" Style="{StaticResource DangerButton}" Command="{Binding RevertCommand}"
                                                    Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Name" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                <c:InfoButton Title="{Binding Name}" Sections="{Binding InfoSections}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource SubtitleText}" FontSize="12" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Description" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 9.9: OneDrive e ferramenta externa (só por clique) -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'OneDrive e ferramentas externas'}" />
                        <c:InfoButton Title="{l:T 'OneDrive e ferramentas externas'}" Margin="0,-6,0,0"
                                      Text="{l:T 'Duas opções separadas para o OneDrive: a política de sincronização (acima, reversível) e a desinstalação pelo winget (aqui, risco Médio, com confirmação dupla; o desfazer reinstala). O O&amp;O ShutUp10++ é um programa gratuito de outra empresa para ajustes de privacidade: o app só abre a página oficial ou instala pelo winget quando você pede, e nunca o executa sozinho nem no Boost.'}" />
                    </StackPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource DangerButton}" Content="{l:T 'Desinstalar o OneDrive'}" Command="{Binding UninstallOneDriveCommand}" Margin="0,0,8,6"
                                AutomationProperties.Name="Desinstalar o OneDrive" />
                        <Button Content="{l:T 'Página oficial do O&amp;O ShutUp10++'}" Command="{Binding OpenShutUpPageCommand}" Margin="0,0,8,6" />
                        <Button Content="{l:T 'Instalar O&amp;O ShutUp10++ (winget)'}" Command="{Binding InstallShutUpCommand}" Margin="0,0,8,6" />
                    </WrapPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="ExtraStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
