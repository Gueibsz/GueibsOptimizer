<UserControl x:Class="GueibsOptimizer.Views.ShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
             xmlns:c="clr-namespace:GueibsOptimizer.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Atalhos'}" />
                <c:InfoButton Title="{l:T 'Atalhos'}" Margin="4,0,0,0" VerticalAlignment="Center"
                              Text="{l:T 'Abre direto as ferramentas clássicas do próprio Windows. O Gueibs Optimizer só abre a janela; nada é alterado.'}" />
            </StackPanel>
            <TextBlock Style="{StaticResource SubtitleText}" Text="{l:T 'Painéis e ferramentas nativas do Windows, a um clique.'}" />
            <TextBlock FontSize="12" Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Status" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
            <ItemsControl ItemsSource="{Binding Items}" Margin="-6,12,-6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="6" Padding="14,12" HorizontalContentAlignment="Left"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Title, StringFormat='Abrir {0}'}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="{Binding Glyph}" FontSize="20"
                                           Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Title" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Description" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Cascadia Mono, Consolas" Text="{Binding Target}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
