<Window x:Class="GueibsOptimizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
        xmlns:vm="clr-namespace:GueibsOptimizer.ViewModels"
        xmlns:v="clr-namespace:GueibsOptimizer.Views"
        Title="{l:T 'Gueibs Optimizer'}" Width="1100" Height="700" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <v:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TweaksViewModel}">
            <v:TweaksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WindowsViewModel}">
            <v:WindowsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverlayTestsViewModel}">
            <v:OverlayTestsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShortcutsViewModel}">
            <v:ShortcutsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WindowsUpdateViewModel}">
            <v:WindowsUpdateView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FixesViewModel}">
            <v:FixesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FeaturesViewModel}">
            <v:FeaturesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DnsViewModel}">
            <v:DnsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PreferencesViewModel}">
            <v:PreferencesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DefenderAiViewModel}">
            <v:DefenderAiView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoryTweaksViewModel}">
            <v:CategoryTweaksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}">
            <v:GamesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DebloatViewModel}">
            <v:DebloatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallAppsViewModel}">
            <v:InstallAppsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}">
            <v:HardwareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <v:ProfilesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RestoreViewModel}">
            <v:RestoreView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navegação lateral (recolhível: só ícones) -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="236" />
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                            <Setter Property="Width" Value="94" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Margin="10,14">
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                    <Button DockPanel.Dock="Right" Command="{Binding ToggleNavCommand}" Padding="8,6" VerticalAlignment="Center"
                            ToolTip="{l:T 'Recolher / expandir o menu'}" AutomationProperties.Name="Recolher menu"
                            Visibility="{Binding IsNavCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE76B;" FontSize="12" />
                    </Button>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE945;" Foreground="{DynamicResource OnAccentBrush}"
                                   HorizontalAlignment="Center" FontSize="18" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsNavCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Text="{l:T 'Gueibs Optimizer'}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{l:T 'Desempenho sem mistério'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </DockPanel>
                <Button DockPanel.Dock="Top" Command="{Binding ToggleNavCommand}" Padding="8,6" HorizontalAlignment="Left" Margin="4,0,0,8"
                        ToolTip="{l:T 'Expandir o menu'}" AutomationProperties.Name="Expandir menu"
                        Visibility="{Binding IsNavCollapsed, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE76C;" FontSize="12" />
                </Button>

                <Grid DockPanel.Dock="Bottom" Margin="6,8,0,0">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding IsNavCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="VersionText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,15,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding OsText}" AutomationProperties.Name="Versão do Windows" Text="{Binding OsText}"
                               Visibility="{Binding IsNavCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding IsNavCollapsed, Converter={StaticResource BoolToVisibility}}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="ShortVersionText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                </Grid>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Badge}" Background="{DynamicResource WarningSoftBrush}" Margin="0,10,0,0"
                        HorizontalAlignment="Stretch" Padding="10,8" ToolTip="{l:T 'MODO SIMULAÇÃO: nenhuma alteração será aplicada ao sistema.'}"
                        Visibility="{Binding IsDryRun, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" FontSize="12"
                                   Text="{l:T 'MODO SIMULAÇÃO: nenhuma alteração será aplicada ao sistema.'}"
                                   Visibility="{Binding IsNavCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center"
                                   Visibility="{Binding IsNavCollapsed, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Margin="10,6,0,4"
                                               Foreground="{DynamicResource TextMutedBrush}">
                                        <TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Title" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Title}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChecked" Click="OnNavClick"
                                                             AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}" Margin="0,1">
                                                    <RadioButton.IsChecked>
                                                        <MultiBinding Converter="{StaticResource EqualityConverter}" Mode="OneWay">
                                                            <Binding />
                                                            <Binding Path="DataContext.SelectedNav" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        </MultiBinding>
                                                    </RadioButton.IsChecked>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource IconText}" Width="26" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Glyph" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                        <TextBlock FontSize="13.5" VerticalAlignment="Center"
                                                                   Visibility="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Title" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                    </StackPanel>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <!-- Conteúdo -->
        <ContentControl Grid.Column="1" Content="{Binding SelectedNav.Page}" Focusable="False" />
    </Grid>
</Window>
