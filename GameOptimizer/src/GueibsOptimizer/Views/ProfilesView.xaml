<UserControl x:Class="GueibsOptimizer.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core">
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Perfis'}" />
            <TextBlock Style="{StaticResource SubtitleText}"
                       Text="{l:T 'Um perfil é uma lista de ajustes. Ao aplicar, o app mostra o que será aplicado e desfeito antes de confirmar. Arquivos .gopro só contêm ids de ajustes conhecidos, nunca comandos.'}" />
            <TextBlock Foreground="{DynamicResource AccentTextBrush}" Margin="0,8,0,0"
                       Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Status" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Salvar ajustes atuais'}" />
                        <TextBlock Text="{l:T 'Nome'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Margin="0,2,0,8"
                                 AutomationProperties.Name="Nome do perfil" />
                        <TextBlock Text="{l:T 'Descrição'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Margin="0,2,0,10"
                                 AutomationProperties.Name="Descrição do perfil" />
                        <Button Content="{l:T 'Salvar como perfil'}" Command="{Binding SaveCurrentCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10" Cursor="Hand">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Name" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}">
                                    <Run ><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="KindText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run>
                                    <Run Text="·" />
                                    <Run ><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="CountText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource SectionText}" FontSize="18" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Selected.Name" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                        <TextBlock Style="{StaticResource SubtitleText}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Selected.Description" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                        <WrapPanel Margin="0,14,0,14">
                            <Button Content="{l:T 'Aplicar perfil'}" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Margin="0,0,8,8"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <Button Content="{l:T 'Duplicar'}" Command="{Binding DuplicateCommand}" Margin="0,0,8,8" />
                            <Button Content="{l:T 'Exportar .gopro'}" Command="{Binding ExportCommand}" Margin="0,0,8,8" />
                            <Button Content="{l:T 'Importar .gopro'}" Command="{Binding ImportCommand}" Margin="0,0,8,8" />
                            <Button Content="{l:T 'Excluir'}" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,8"
                                    IsEnabled="{Binding CanModifySelected}" />
                        </WrapPanel>
                        <TextBlock Text="{l:T 'Ajustes deste perfil'}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedTweakNames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2"><Run Text="• " /><Run><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="." Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
