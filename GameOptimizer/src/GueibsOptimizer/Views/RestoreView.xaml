<UserControl x:Class="GueibsOptimizer.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core">
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Restauração'}" />
            <TextBlock Style="{StaticResource SubtitleText}"
                       Text="{l:T 'Histórico de tudo que o Gueibs Optimizer alterou, com o valor anterior. Desfazer devolve exatamente o valor (e o tipo) que existia antes.'}" />
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="{l:T 'Desfazer tudo'}" Style="{StaticResource DangerButton}" Command="{Binding UndoAllCommand}" />
                <Button Content="{l:T 'Abrir Restaurar Sistema do Windows'}" Margin="10,0,0,0" Command="{Binding OpenSystemRestoreCommand}" />
                <Button Content="{l:T 'Atualizar'}" Margin="10,0,0,0" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </StackPanel>

        <Grid>
            <TextBlock Style="{StaticResource SubtitleText}" Text="{l:T 'Nenhuma alteração registrada até agora.'}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LocalTime, StringFormat=dd/MM/yyyy HH:mm}" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock FontWeight="SemiBold" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="TweakName" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Description" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                        <TextBlock FontSize="12" TextWrapping="Wrap">
                                            <Run Text="{l:T 'Valor anterior:'}" Foreground="{DynamicResource TextMutedBrush}" />
                                            <Run ><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="PreviousValue" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{l:T 'Desfazer este'}" VerticalAlignment="Center"
                                            Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
