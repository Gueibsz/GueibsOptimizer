<Window x:Class="GueibsOptimizer.Views.PollingTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
        Title="{l:T 'Teste de polling rate do mouse'}" Width="560" Height="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Polling rate do mouse'}" />
        <TextBlock Style="{StaticResource SubtitleText}"
                   Text="{l:T 'Mova o mouse rápido e em círculos por alguns segundos. A leitura usa Raw Input (WM_INPUT) com relógio de alta resolução, sem depender dos eventos agrupados do WPF.'}" />
        <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{l:T 'Atual'}" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="CurrentText" Text="{l:T '— Hz'}" FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="{l:T 'Média (Hz)'}" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="AverageText" Text="{l:T '— Hz'}" FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T 'Máximo'}" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="MaxText" Text="{l:T '— Hz'}" FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock x:Name="NearestText" Margin="0,18,0,0" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" Text="{l:T 'Mova o mouse para começar.'}" />
        <TextBlock x:Name="EventsText" Margin="0,6,0,0" Foreground="{DynamicResource TextMutedBrush}" />
        <Button Content="{l:T 'Zerar'}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnReset" />
        <TextBlock Style="{StaticResource SubtitleText}" Margin="0,14,0,0" FontSize="11.5"
                   Text="{l:T 'Em 4000/8000 Hz, alguns sistemas entregam leituras agrupadas e o valor medido pode ficar abaixo do configurado.'}" />
    </StackPanel>
</Window>
