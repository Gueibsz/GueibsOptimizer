<UserControl x:Class="GueibsOptimizer.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
             xmlns:c="clr-namespace:GueibsOptimizer.Views.Controls"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <!-- Configurações do jogo no estilo "atual × recomendado": a pessoa escolhe item por item. -->
        <DataTemplate x:Key="PresetPanel">
            <StackPanel>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="ModeText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding Summary, Converter={StaticResource NotEmptyToVisibility}}"><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Summary" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOptimized}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Tabela -->
                <Border Margin="0,8,0,0" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                        Visibility="{Binding HasTable, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid Background="{DynamicResource SurfaceAltBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{l:T 'CONFIGURAÇÃO'}" Margin="10,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{l:T 'ATUAL'}" Margin="0,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="2" Text="{l:T 'RECOMENDADO'}" Margin="0,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="3" Text="{l:T 'USAR'}" Margin="0,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Margin="10,6" VerticalAlignment="Center" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Label" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="CurrentText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="RecommendedText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                                          Visibility="{Binding CanSelect, Converter={StaticResource BoolToVisibility}}"
                                                          AutomationProperties.Name="{Binding Label, StringFormat='Usar o recomendado em {0}'}" />
                                                <TextBlock Text="{l:T '✓ ok'}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" VerticalAlignment="Center"
                                                           Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0,8,0,0" Visibility="{Binding CanAutoApply, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="{l:T 'Marcar todas'}" Command="{Binding SelectAllRecommendedCommand}" Margin="0,0,8,6" IsEnabled="{Binding HasTable}" />
                    <Button Content="{l:T 'Desmarcar'}" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,6" IsEnabled="{Binding HasTable}" />
                    <Button Content="{l:T 'Otimizar selecionadas'}" Style="{StaticResource PrimaryButton}" Command="{Binding ApplySelectedCommand}" Margin="0,0,8,6"
                            IsEnabled="{Binding HasTable}" AutomationProperties.Name="{Binding Name, StringFormat='Otimizar configurações de {0}'}" />
                    <Button Content="{l:T 'Restaurar config original'}" Command="{Binding RestoreConfigCommand}" IsEnabled="{Binding HasBackup}" Margin="0,0,8,6" />
                    <Button Content="{l:T 'Atualizar'}" Command="{Binding ReloadCommand}" Margin="0,0,8,6" />
                    <c:InfoButton Title="{l:T 'Configurações do jogo'}" Margin="0,0,8,6"
                                  Text="{l:T 'O app lê o arquivo de opções que o próprio jogo grava quando você muda algo no menu (ex.: GameUserSettings.ini, game.cfg, GraphicsConfig.xml) e compara com o recomendado para o nível do seu PC. Nada é marcado sozinho: você escolhe cada opção. Ao otimizar: o jogo precisa estar fechado, é feito um backup do arquivo (.bak com data) ao lado dele e só as opções marcadas mudam. Arquivos marcados como somente leitura não são alterados. Restaurar config original volta o backup mais antigo. Executáveis e a memória do jogo nunca são tocados.'}" />
                </WrapPanel>
                <TextBlock Foreground="{DynamicResource AccentTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Status" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>

                <!-- Sem arquivo conhecido (ou dicas extras) -->
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding HasTable, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Recommendations" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextMutedBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="General" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Meus Jogos'}" />
            <TextBlock Style="{StaticResource SubtitleText}"
                       Text="{l:T 'Jogos encontrados no PC e ajustes por jogo. Tudo é feito no nível do Windows (registro e lista do Game Booster): nada é alterado dentro da pasta ou da memória do jogo, e cada ajuste pode ser desfeito.'}" />

            <!-- Ações -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="{l:T 'Atualizar'}" Command="{Binding RefreshCommand}" Margin="0,0,8,8"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Content="{l:T 'Adicionar pasta'}" Command="{Binding AddFolderCommand}" Margin="0,0,8,8" />
                        <Button Content="{l:T 'Adicionar .exe'}" Command="{Binding AddExeCommand}" Margin="0,0,8,8" />
                        <c:InfoButton Title="{l:T 'Como os jogos são encontrados'}" Margin="0,0,8,8"
                                      Text="{l:T 'Steam: bibliotecas do libraryfolders.vdf e os appmanifest de cada jogo. Epic Games: manifests em ProgramData\\Epic. Riot, EA, Ubisoft, Battle.net, Rockstar e Activision: registro de desinstalação. O executável principal é escolhido ignorando instaladores, launchers, anti-cheat e crash handlers. Se faltar algum jogo, ou o .exe estiver errado, use Adicionar pasta ou Adicionar .exe (fica salvo em games-library.json).'}" />
                    </WrapPanel>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Status" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    <TextBlock Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="TierText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                </StackPanel>
            </Border>

            <!-- Lista de jogos -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,10">
                                <StackPanel>
                                    <DockPanel>
                                        <Image DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"
                                               Source="{Binding Executable, Converter={StaticResource ExeIcon}}" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock FontSize="12" HorizontalAlignment="Right"
                                                           Visibility="{Binding Preset.ShortStatus, Converter={StaticResource NotEmptyToVisibility}, FallbackValue=Collapsed}"><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Preset.ShortStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Preset.IsOptimized}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Right" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Summary" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                            </StackPanel>
                                            <Button Content="{l:T 'Otimizar para o meu PC'}" Style="{StaticResource PrimaryButton}" Command="{Binding OptimizeCommand}"
                                                    IsEnabled="{Binding HasExecutable}" Margin="0,0,8,0"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Otimizar {0}'}" />
                                            <Button Content="{l:T 'Ajustes'}" Command="{Binding ToggleExpandedCommand}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Ajustes de {0}'}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Name" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis">
                                                <Run ><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="SourceText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run><Run Text=" · " /><Run ><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="ExeText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Folder" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Foreground="{DynamicResource AccentTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="44,6,0,0"
                                               Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Status" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>

                                    <!-- Detalhes: opções por jogo e recomendações -->
                                    <StackPanel Margin="44,8,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Margin="0,0,0,14" Visibility="{Binding HasPreset, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{l:T 'Configurações gráficas do jogo'}" Style="{StaticResource SectionText}" />
                                            <ContentControl Content="{Binding Preset}" ContentTemplate="{StaticResource PresetPanel}" Focusable="False" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,14" Visibility="{Binding HasPreset, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                            <TextBlock Text="{l:T 'Configurações gráficas do jogo'}" Style="{StaticResource SectionText}" />
                                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{l:T 'Não foi encontrado um arquivo de opções gráficas que o app consiga ler com segurança para este jogo. Isso acontece com jogos que guardam as opções em formato próprio, na nuvem ou no registro (ex.: jogos Unity). Ajuste pelo menu do jogo; os ajustes do Windows abaixo continuam valendo.'}" />
                                        </StackPanel>
                                        <TextBlock Text="{l:T 'Ajustes do Windows para este jogo'}" Style="{StaticResource SectionText}" />
                                        <ItemsControl ItemsSource="{Binding Options}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,4">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                                                       VerticalAlignment="Center" Margin="0,0,10,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Status" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                            <Button Content="{l:T 'Aplicar'}" Command="{Binding ApplyCommand}"
                                                                    Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                            <Button Content="{l:T 'Desfazer'}" Style="{StaticResource DangerButton}" Command="{Binding RevertCommand}"
                                                                    Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock VerticalAlignment="Center" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Name" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                            <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"><Run Text=" (" /><Run><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="RiskText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run><Run Text=")" /></TextBlock>
                                                            <c:InfoButton Title="{Binding Name}" Text="{Binding InfoText}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="{l:T 'Desfazer tudo deste jogo'}" Style="{StaticResource DangerButton}" Command="{Binding UndoAllCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Presets de jogos populares -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Presets de jogos populares'}" />
                        <c:InfoButton Title="{l:T 'Presets por jogo'}"
                                      Text="{l:T 'Configurações dentro do jogo recomendadas para o nível do seu PC (Entrada, Médio, Alto ou Topo, detectado pela placa de vídeo, processador e RAM). Fortnite, League of Legends, ELDEN RING e Minecraft Java: o app lê o arquivo de opções do jogo, mostra o atual e o recomendado, e você escolhe o que aplicar (com backup .bak e Restaurar config original). CS2, VALORANT, Apex, GTA V, Roblox e Warzone: só recomendações em texto, porque as opções ficam na nuvem/conta ou o formato não foi verificado.'}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,8">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,2" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Name" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PresetPanel}" Focusable="False" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
