<UserControl x:Class="GueibsOptimizer.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
             xmlns:c="clr-namespace:GueibsOptimizer.Views.Controls"
             xmlns:svc="clr-namespace:GueibsOptimizer.Services"
             xmlns:m="clr-namespace:GueibsOptimizer.Models"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <DataTemplate x:Key="MetricCard">
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="14,12" Width="250">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" FontSize="18" FontWeight="SemiBold" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="ValueText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Title" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    </DockPanel>
                    <c:Sparkline Height="56" Margin="0,8,0,0" Values="{Binding History60}" Maximum="{Binding Maximum}"
                                 Stroke="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- Uma aba do Meu PC: rótulo e valor -->
        <DataTemplate x:Key="PcSectionTemplate">
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Label" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap"><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Value" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Hardware'}" />
            <TextBlock Style="{StaticResource SubtitleText}" Text="{l:T 'Sensores ao vivo, resumo do PC e um check-up das configurações que mais afetam jogos.'}" />
        </StackPanel>

        <TabControl Margin="0,12,0,0" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
            <TabItem Header="{l:T 'Monitor ao vivo'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="{Binding SensorNote, Converter={StaticResource NotEmptyToVisibility}}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="SensorNote" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                    Visibility="{Binding CpuSensorsMissing, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="{l:T 'Instalar driver PawnIO (winget)'}" Command="{Binding InstallPawnIOCommand}"
                                    IsEnabled="{Binding IsInstallingDriver, Converter={StaticResource InverseBool}}" />
                            <c:InfoButton Title="{l:T 'Driver PawnIO'}" Text="{x:Static m:UiHelp.PawnIO}" />
                        </StackPanel>
                        <WrapPanel>
                            <ContentControl Content="{Binding CpuLoad}" ContentTemplate="{StaticResource MetricCard}" />
                            <ContentControl Content="{Binding CpuTemp}" ContentTemplate="{StaticResource MetricCard}" />
                            <ContentControl Content="{Binding CpuPower}" ContentTemplate="{StaticResource MetricCard}" />
                            <ContentControl Content="{Binding GpuLoad}" ContentTemplate="{StaticResource MetricCard}" />
                            <ContentControl Content="{Binding GpuTemp}" ContentTemplate="{StaticResource MetricCard}" />
                            <ContentControl Content="{Binding RamLoad}" ContentTemplate="{StaticResource MetricCard}" />
                        </WrapPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Margin="0,2"><Run Text="{l:T 'CPU · '}" /><Run><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="CpuDetail" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run></TextBlock>
                                <TextBlock Margin="0,2"><Run Text="{l:T 'GPU · '}" /><Run><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="GpuDetail" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run></TextBlock>
                                <TextBlock Margin="0,2"><Run Text="{l:T 'RAM · '}" /><Run><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="RamDetail" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run></TextBlock>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Todos os sensores'}" Margin="0,8,0,8" />
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,12,10" Padding="14,10">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Name" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                            <ItemsControl ItemsSource="{Binding Readings}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Width="250" Margin="0,1,16,1">
                                                            <TextBlock DockPanel.Dock="Right" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="ValueText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Sensor" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{l:T 'Meu PC'}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button Content="{l:T 'Copiar resumo'}" Style="{StaticResource PrimaryButton}" Command="{Binding CopySummaryCommand}" Margin="0,0,0,6" />
                        <c:InfoButton Title="{l:T 'Copiar resumo'}" Text="{x:Static m:UiHelp.CopySummary}" Margin="0,0,0,6" />
                        <Button Content="{l:T 'Atualizar'}" Margin="4,0,0,6" Command="{Binding LoadInfoCommand}" />
                        <c:InfoButton Title="{l:T 'Atualizar informações'}" Text="{x:Static m:UiHelp.RefreshInfo}" Margin="0,0,16,6" />
                        <TextBlock Text="{l:T 'Exportar relatório:'}" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{DynamicResource TextMutedBrush}" />
                        <Button Content="{l:T 'Texto (.txt)'}" Command="{Binding ExportReportCommand}" CommandParameter="txt" Margin="0,0,6,6" AutomationProperties.Name="Exportar relatório em texto" />
                        <Button Content="{l:T 'Página (.html)'}" Command="{Binding ExportReportCommand}" CommandParameter="html" Margin="0,0,6,6" AutomationProperties.Name="Exportar relatório em HTML" />
                        <Button Content="{l:T 'Dados (.json)'}" Command="{Binding ExportReportCommand}" CommandParameter="json" Margin="0,0,10,6" AutomationProperties.Name="Exportar relatório em JSON" />
                        <CheckBox Content="{l:T 'Incluir números de série'}" IsChecked="{Binding IncludeSerials}" VerticalAlignment="Center" Margin="0,0,0,6"
                                  Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="Incluir números de série" />
                        <c:InfoButton Title="{l:T 'Exportar relatório'}" Margin="0,0,0,6"
                                      Text="{l:T 'Salva todas as abas do Meu PC em .txt, .html ou .json. Os números de série (placa-mãe, BIOS, discos e pentes de memória) ficam de fora por padrão, porque identificam o seu PC; marque Incluir números de série só se precisar deles (por exemplo, para garantia). Nada é enviado pela internet.'}" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"
                               Visibility="{Binding ExportStatus, Converter={StaticResource NotEmptyToVisibility}}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="ExportStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    <TabControl>
                        <TabItem Header="{l:T 'Visão geral'}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SubtitleText}" Margin="0,0,0,10"
                                               Text="{l:T 'Diagrama esquemático com os componentes detectados agora. Não é uma foto da placa: a posição dos blocos é ilustrativa.'}" />
                                    <!-- Diagrama original: memória no topo, CPU ligada à GPU e ao chipset, chipset ligado ao armazenamento. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Slots de memória -->
                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="12,10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{l:T 'Memória RAM'}" />
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="DiagramMemory" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                <ItemsControl ItemsSource="{Binding DiagramSlots}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="Slot" Width="150" Margin="0,0,6,6" Padding="6,4" CornerRadius="3" BorderThickness="1"
                                                                    BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceAltBrush}" ToolTip="{Binding Text}">
                                                                <StackPanel>
                                                                    <Rectangle Height="5" Fill="{DynamicResource AccentBrush}" x:Name="Bar" Margin="0,0,0,4" />
                                                                    <TextBlock FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Locator" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                                    <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Text" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Occupied}" Value="False">
                                                                    <Setter TargetName="Slot" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                                    <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource BorderBrush}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Ligações -->
                                        <Rectangle Grid.Row="1" Grid.Column="0" Width="3" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                        <Rectangle Grid.Row="2" Grid.Column="1" Height="3" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                        <Rectangle Grid.Row="3" Grid.Column="0" Width="3" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                        <Rectangle Grid.Row="4" Grid.Column="1" Height="3" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Center" />

                                        <!-- CPU -->
                                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="12,10" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{l:T 'Processador'}" />
                                                <TextBlock FontSize="12" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="DiagramCpu" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- GPU -->
                                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="12,10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{l:T 'Placa de vídeo (PCIe)'}" />
                                                <ItemsControl ItemsSource="{Binding DiagramGpus}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Chipset -->
                                        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource Card}" Padding="12,10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{l:T 'Chipset'}" />
                                                <TextBlock FontSize="12" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="DiagramChipset" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- Armazenamento -->
                                        <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource Card}" Padding="12,10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{l:T 'Armazenamento'}" />
                                                <ItemsControl ItemsSource="{Binding DiagramDisks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Expander Header="{l:T 'Resumo em texto'}" Margin="0,14,0,0" Foreground="{DynamicResource TextBrush}">
                                        <TextBox Text="{Binding PcSummary, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Margin="0,6,0,0"
                                                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextWrapping="Wrap" />
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{l:T 'Processador'}" Content="{Binding PcSections[0]}" ContentTemplate="{StaticResource PcSectionTemplate}" />
                        <TabItem Header="{l:T 'Caches'}" Content="{Binding PcSections[1]}" ContentTemplate="{StaticResource PcSectionTemplate}" />
                        <TabItem Header="{l:T 'Placa-mãe'}" Content="{Binding PcSections[2]}" ContentTemplate="{StaticResource PcSectionTemplate}" />
                        <TabItem Header="{l:T 'Memória'}" Content="{Binding PcSections[3]}" ContentTemplate="{StaticResource PcSectionTemplate}" />
                        <TabItem Header="{l:T 'Slots de memória'}" Content="{Binding PcSections[4]}" ContentTemplate="{StaticResource PcSectionTemplate}" />
                        <TabItem Header="{l:T 'Gráficos'}" Content="{Binding PcSections[5]}" ContentTemplate="{StaticResource PcSectionTemplate}" />
                        <TabItem Header="{l:T 'Armazenamento'}" Content="{Binding PcSections[6]}" ContentTemplate="{StaticResource PcSectionTemplate}" />
                        <TabItem Header="{l:T 'Check-up'}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource SubtitleText}"
                                           Text="{l:T 'O Check-up verifica Dual Channel, XMP/EXPO, link PCIe da placa de vídeo, plano de energia, Modo de Jogo, HAGS e taxa de atualização do monitor.'}" />
                                <Button Content="{l:T 'Abrir o Check-up'}" Command="{Binding OpenCheckupTabCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>

            <TabItem Header="{l:T 'Check-up'}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="{l:T 'Verificar de novo'}" Command="{Binding RunCheckupCommand}"
                                IsEnabled="{Binding IsCheckingUp, Converter={StaticResource InverseBool}}" />
                        <c:InfoButton Title="{l:T 'Check-up'}" Text="{x:Static m:UiHelp.Checkup}" />
                        <TextBlock Text="{l:T 'Verificando...'}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                                   Visibility="{Binding IsCheckingUp, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CheckItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:CheckItem}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Pill" Style="{StaticResource Badge}" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                    BorderThickness="1" BorderBrush="{DynamicResource SuccessBrush}">
                                                <TextBlock x:Name="PillText" Foreground="{DynamicResource SuccessBrush}" FontSize="12" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="StatusText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Title" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                <TextBlock Style="{StaticResource SubtitleText}" Margin="0,4,0,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Detail" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"><Run Text="{l:T 'Como corrigir:'}" /><Run Text=" " /><Run><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="HowToFix" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run></TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:CheckStatus.Attention}">
                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:CheckStatus.Error}">
                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
