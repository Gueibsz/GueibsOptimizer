<UserControl x:Class="GueibsOptimizer.Views.InstallAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core">
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Instalar Apps'}" />
            <TextBlock Style="{StaticResource SubtitleText}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="CatalogInfo" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
        </StackPanel>

        <TabControl Margin="0,10,0,0" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
            <!-- Catálogo -->
            <TabItem Header="{l:T 'Catálogo'}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar programa" />
                            <TextBlock Text="{l:T 'Buscar por nome, descrição ou ID do winget...'}" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"
                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}" />
                        </Grid>
                        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" CornerRadius="14" Padding="12,4" Margin="0,0,6,6" Cursor="Hand"
                                                        Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextBrush}">
                                                        <TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text>
                                                    </TextBlock>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <ListBox ItemsSource="{Binding View}" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,8">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{Binding Name}" />
                                            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentTextBrush}"
                                                       VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Status" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" ><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Name" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run>
                                                    <Run Text=" · " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" /><Run FontSize="11" Foreground="{DynamicResource TextMutedBrush}"><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Category" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run>
                                                </TextBlock>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Description" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Fila de instalação'}" />
                            <TextBlock><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text="{l:T ' selecionado(s)'}" /></TextBlock>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="{l:T 'Essenciais para jogos'}" Command="{Binding SelectEssentialsCommand}" Margin="0,0,8,8" />
                                <Button Content="{l:T 'Limpar seleção'}" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,8" />
                            </WrapPanel>
                            <Button Content="{l:T 'Instalar selecionados'}" Style="{StaticResource PrimaryButton}" Command="{Binding InstallSelectedCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Margin="0,6,0,0" />
                            <ProgressBar Value="{Binding QueueProgress}" Maximum="100" Margin="0,14,0,0" />
                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextMutedBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="QueueStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                            <Button Content="{l:T 'Cancelar fila'}" Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}"
                                    IsEnabled="{Binding IsBusy}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                                       Visibility="{Binding Report, Converter={StaticResource NotEmptyToVisibility}}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Report" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Atualizações -->
            <TabItem Header="{l:T 'Atualizações'}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="{l:T 'Verificar'}" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Content="{l:T 'Atualizar tudo'}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Command="{Binding UpgradeAllCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="UpdatesStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Upgrades}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentTextBrush}">
                                                <Run ><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Version" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run>
                                                <Run Text="→" />
                                                <Run ><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Available" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run>
                                            </TextBlock>
                                            <TextBlock>
                                                <Run FontWeight="SemiBold" ><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Name" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run>
                                                <Run FontSize="11" Foreground="{DynamicResource TextMutedBrush}" ><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Id" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Formatação guiada -->
            <TabItem Header="{l:T 'Formatação guiada'}">
                <Grid DataContext="{Binding Wizard}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Pós-formatação em 6 passos'}" />
                            <TextBlock Style="{StaticResource SubtitleText}" TextWrapping="Wrap"
                                       Text="{l:T '1. Escolher perfil e programas · 2. Ponto de restauração · 3. Instalar programas · 4. Boost, privacidade e Debloat · 5. Runtimes e plano de energia · 6. Resumo e reinício.'}" />
                            <TextBlock Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" Margin="0,10,0,10" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Header" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                            <TextBlock Text="{l:T 'Perfil'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <ListBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile}" Margin="0,4,0,10">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="8" Padding="10,6" Margin="0,0,0,4" Cursor="Hand"
                                                            Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <TextBlock Style="{StaticResource SubtitleText}" FontSize="12"
                                       Text="{l:T 'Os programas são os marcados na aba Catálogo (use &quot;Essenciais para jogos&quot; para uma seleção pronta).'}" />
                            <TextBlock Text="{l:T 'Predefinições de programas'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,4" />
                            <ItemsControl ItemsSource="{Binding AppPresetNames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,6,6" Padding="10,4" FontSize="12"
                                                Command="{Binding DataContext.ApplyAppPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding StringFormat='Predefinição {0}'}">
                                            <TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{l:T 'Escolher por categoria no Catálogo'}" Command="{Binding OpenCatalogCommand}" HorizontalAlignment="Left" FontSize="12" Padding="10,4" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource AccentTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding PresetStatus, Converter={StaticResource NotEmptyToVisibility}}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="PresetStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                            <TextBlock Text="{l:T 'Debloat (apps pré-instalados)'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{Binding DebloatChoices}" SelectedItem="{Binding SelectedDebloat}" AutomationProperties.Name="Predefinição de Debloat">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{StaticResource SubtitleText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="{l:T 'Leve remove só apps seguros; Equilibrado inclui opcionais comuns. Itens protegidos nunca são removidos. Para revisar item a item, use a tela Debloat.'}" />
                            <TextBlock Text="{l:T 'Extras'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,4" />
                            <CheckBox IsChecked="{Binding InstallRuntimes}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"
                                      Content="{l:T 'Instalar runtimes (VC++ 2015-2022, .NET Desktop Runtime 8, DirectX)'}" />
                            <CheckBox IsChecked="{Binding ApplyPowerPlan}" Foreground="{DynamicResource TextBrush}"
                                      Content="{l:T 'Ativar o plano de energia de alto desempenho'}" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="{l:T 'Começar'}" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Margin="0,0,8,8"
                                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                                <Button Content="{l:T 'Retomar'}" Command="{Binding ResumeCommand}" Margin="0,0,8,8" IsEnabled="{Binding CanResume}" />
                                <Button Content="{l:T 'Descartar'}" Style="{StaticResource DangerButton}" Command="{Binding DiscardCommand}" Margin="0,0,8,8" />
                                <Button Content="{l:T 'Reiniciar o PC'}" Command="{Binding RestartCommand}" Margin="0,0,8,8" IsEnabled="{Binding IsFinished}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionText}" Text="{l:T 'Andamento'}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Log}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
