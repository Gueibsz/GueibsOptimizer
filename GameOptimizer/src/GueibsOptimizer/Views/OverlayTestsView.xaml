<UserControl x:Class="GueibsOptimizer.Views.OverlayTestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
             xmlns:c="clr-namespace:GueibsOptimizer.Views.Controls"
             xmlns:m="clr-namespace:GueibsOptimizer.Models"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Overlay &amp; Testes'}" />
            <TextBlock Style="{StaticResource SubtitleText}"
                       Text="{l:T 'Nada aqui injeta código em jogos: o FPS vem de eventos do Windows (ETW) lidos pelo PresentMon, e o overlay é uma janela transparente comum. Seguro para jogos com anti-cheat.'}" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Overlay -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Overlay'}" />
                        <TextBlock Style="{StaticResource SubtitleText}" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="HotkeyText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                        <TextBlock Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{l:T 'Funciona com jogos em &quot;tela cheia sem bordas&quot; ou janela. Em tela cheia exclusiva o Windows não exibe janelas por cima.'}" />
                        <WrapPanel Margin="0,12,0,0">
                            <CheckBox Content="{l:T 'FPS'}" IsChecked="{Binding ShowFps}" Foreground="{DynamicResource TextBrush}" Margin="0,0,14,6" />
                            <CheckBox Content="{l:T '1% / 0.1% low'}" IsChecked="{Binding ShowLows}" Foreground="{DynamicResource TextBrush}" Margin="0,0,14,6" />
                            <CheckBox Content="{l:T 'CPU'}" IsChecked="{Binding ShowCpu}" Foreground="{DynamicResource TextBrush}" Margin="0,0,14,6" />
                            <CheckBox Content="{l:T 'GPU'}" IsChecked="{Binding ShowGpu}" Foreground="{DynamicResource TextBrush}" Margin="0,0,14,6" />
                            <CheckBox Content="{l:T 'Temperaturas'}" IsChecked="{Binding ShowTemps}" Foreground="{DynamicResource TextBrush}" Margin="0,0,14,6" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{l:T 'Mostrar / ocultar'}" Style="{StaticResource PrimaryButton}" Command="{Binding ToggleOverlayCommand}" />
                            <c:InfoButton Title="{l:T 'Overlay'}" Text="{x:Static m:UiHelp.Overlay}" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEditMode}" Margin="10,0,8,0" VerticalAlignment="Center"
                                      AutomationProperties.Name="Modo edição" />
                            <TextBlock Text="{l:T 'Modo edição (arrastar)'}" VerticalAlignment="Center" />
                            <c:InfoButton Title="{l:T 'Modo edição'}" Text="{x:Static m:UiHelp.OverlayEdit}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- FPS -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Medição de FPS (PresentMon)'}" />
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="FpsValues" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                        <TextBlock Style="{StaticResource SubtitleText}" Margin="0,4,0,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="FpsStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding PresentMonPath}" Margin="0,4,0,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="PresentMonPath" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                        <WrapPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,8">
                                <Button Content="{l:T 'Iniciar / parar'}" Style="{StaticResource PrimaryButton}" Command="{Binding ToggleFpsCommand}" />
                                <c:InfoButton Title="{l:T 'Medição de FPS'}" Text="{x:Static m:UiHelp.Fps}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,8">
                                <Button Content="{l:T 'Baixar PresentMon oficial'}" Command="{Binding DownloadPresentMonCommand}"
                                        IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}" />
                                <c:InfoButton Title="{l:T 'Baixar PresentMon oficial'}" Text="{x:Static m:UiHelp.PresentMonDownload}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,8">
                                <Button Content="{l:T 'Apontar PresentMon.exe'}" Command="{Binding PickPresentMonCommand}" />
                                <c:InfoButton Title="{l:T 'Apontar PresentMon.exe'}" Text="{x:Static m:UiHelp.PresentMonPick}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,8">
                                <Button Content="{l:T 'Página oficial'}" Command="{Binding OpenPresentMonPageCommand}" />
                                <c:InfoButton Title="{l:T 'Página oficial'}" Text="{x:Static m:UiHelp.PresentMonPage}" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource SubtitleText}" FontSize="11.5"
                                   Text="{l:T 'Mede o programa em primeiro plano. 1% low = FPS médio dos 1% quadros mais lentos (janela dos últimos 10 s).'}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Rede -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Rede'}" />
                    <DockPanel>
                        <c:InfoButton DockPanel.Dock="Right" Title="{l:T 'Testar ping'}" Text="{x:Static m:UiHelp.Ping}" />
                        <Button DockPanel.Dock="Right" Content="{l:T 'Testar ping'}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                Command="{Binding RunPingCommand}" IsEnabled="{Binding IsNetworkBusy, Converter={StaticResource InverseBool}}" />
                        <TextBox Text="{Binding PingTargets, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Alvos de ping" />
                    </DockPanel>
                    <c:Sparkline Height="70" Margin="0,10,0,0" Values="{Binding PingSeries}" Maximum="0" Capacity="120"
                                 Stroke="{DynamicResource AccentBrush}" />
                    <ItemsControl ItemsSource="{Binding PingResults}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Margin="0,12" Background="{DynamicResource BorderBrush}" />
                    <TextBlock TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="SpeedStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    <ProgressBar Value="{Binding SpeedProgress}" Maximum="100" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{l:T 'Testar velocidade'}" Command="{Binding RunSpeedTestCommand}"
                                IsEnabled="{Binding IsNetworkBusy, Converter={StaticResource InverseBool}}" />
                        <c:InfoButton Title="{l:T 'Testar velocidade'}" Text="{x:Static m:UiHelp.SpeedTest}" />
                        <Button Content="{l:T 'Cancelar'}" Style="{StaticResource DangerButton}" Margin="4,0,0,0" Command="{Binding CancelNetworkCommand}"
                                IsEnabled="{Binding IsNetworkBusy}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Periféricos e monitor -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Polling rate do mouse'}" />
                        <TextBlock Style="{StaticResource SubtitleText}" Text="{l:T 'Mede quantas vezes por segundo o mouse envia dados (125 a 8000 Hz) usando Raw Input.'}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{l:T 'Abrir teste'}" Command="{Binding OpenPollingCommand}" AutomationProperties.Name="Abrir teste de polling" />
                            <c:InfoButton Title="{l:T 'Polling rate do mouse'}" Text="{x:Static m:UiHelp.Polling}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="{l:T 'Teste do monitor'}" />
                        <TextBlock Style="{StaticResource SubtitleText}" Text="{l:T 'UFO em movimento, rastro (ghosting) e taxa de atualização real.'}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{l:T 'Abrir teste'}" Command="{Binding OpenMonitorCommand}" AutomationProperties.Name="Abrir teste do monitor" />
                            <c:InfoButton Title="{l:T 'Teste do monitor'}" Text="{x:Static m:UiHelp.MonitorTest}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
