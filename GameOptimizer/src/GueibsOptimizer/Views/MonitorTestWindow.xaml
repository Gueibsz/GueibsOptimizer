<Window x:Class="GueibsOptimizer.Views.MonitorTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
        Title="{l:T 'Teste do monitor'}" Width="1000" Height="640" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Teste do monitor'}" />
            <TextBlock x:Name="RefreshText" Style="{StaticResource SubtitleText}" Text="{l:T 'Medindo a taxa de atualização...'}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="{l:T 'Velocidade:'}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Slider x:Name="SpeedSlider" Width="260" Minimum="240" Maximum="2400" Value="960" TickFrequency="240"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Velocidade em pixels por segundo" />
                <TextBlock Text="{Binding Value, ElementName=SpeedSlider, StringFormat={}{0:0} px/s}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <TabControl Margin="0,12,0,0">
            <TabItem Header="{l:T 'UFO (movimento)'}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Canvas x:Name="UfoCanvas" Background="{DynamicResource TestDarkBrush}" ClipToBounds="True">
                        <Border x:Name="Ufo" Width="64" Height="64" CornerRadius="10" Background="{DynamicResource AccentBrush}" Canvas.Top="20">
                            <Grid>
                                <Ellipse Width="12" Height="12" Fill="{DynamicResource OnAccentBrush}" Margin="0,0,18,10" />
                                <Ellipse Width="12" Height="12" Fill="{DynamicResource OnAccentBrush}" Margin="18,0,0,10" />
                            </Grid>
                        </Border>
                    </Canvas>
                    <TextBlock Grid.Row="1" Margin="0,10" Style="{StaticResource SubtitleText}"
                               Text="{l:T 'Acompanhe o quadrado com os olhos: quanto mais nítido ele parecer, menor o borrão de movimento do monitor. Compare com taxas de atualização diferentes.'}" />
                    <Canvas Grid.Row="2" x:Name="UfoCanvas2" Background="{DynamicResource TestDarkBrush}" ClipToBounds="True">
                        <Border x:Name="Ufo2" Width="64" Height="64" CornerRadius="10" Background="{DynamicResource TestWhiteBrush}" Canvas.Top="20" />
                    </Canvas>
                </Grid>
            </TabItem>
            <TabItem Header="{l:T 'Rastro (ghosting)'}">
                <Canvas x:Name="BarsCanvas" Background="{DynamicResource TestGrayBrush}" ClipToBounds="True">
                    <StackPanel x:Name="Bars" Orientation="Horizontal" Canvas.Top="40">
                        <Rectangle Width="16" Height="300" Fill="{DynamicResource TestBlackBrush}" Margin="0,0,40,0" />
                        <Rectangle Width="16" Height="300" Fill="{DynamicResource TestWhiteBrush}" Margin="0,0,40,0" />
                        <Rectangle Width="16" Height="300" Fill="{DynamicResource AccentBrush}" Margin="0,0,40,0" />
                        <Rectangle Width="16" Height="300" Fill="{DynamicResource TestDimBrush}" />
                    </StackPanel>
                </Canvas>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
