<UserControl x:Class="GueibsOptimizer.Views.Controls.InfoButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
             x:Name="Root" VerticalAlignment="Center" Focusable="False">
    <!-- Título, texto, dica e seções são traduzidos na hora de mostrar (chave = texto em português). -->
    <Grid>
        <ToggleButton x:Name="Toggle" Width="22" Height="22" Cursor="Hand" Margin="6,0"
                      AutomationProperties.Name="{Binding Title, ElementName=Root, StringFormat='Mais informações: {0}'}"
                      AutomationProperties.HelpText="{Binding ShortTip, ElementName=Root}">
            <ToggleButton.ToolTip>
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource Tr}" Mode="OneWay">
                            <Binding Path="ShortTip" ElementName="Root" />
                            <Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </ToggleButton.ToolTip>
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="11" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}" Background="Transparent">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" x:Name="Glyph"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="Popup" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Opened="OnOpened" Closed="OnClosed">
            <Border x:Name="Panel" MaxWidth="440" Padding="16,14" CornerRadius="10" BorderThickness="1"
                    Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    Focusable="True" KeyDown="OnPanelKeyDown"
                    AutomationProperties.Name="{Binding Title, ElementName=Root}">
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,6">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Tr}" Mode="OneWay">
                                    <Binding Path="Title" ElementName="Root" />
                                    <Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"
                                   Visibility="{Binding Text, ElementName=Root, Converter={StaticResource NotEmptyToVisibility}}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Tr}" Mode="OneWay">
                                    <Binding Path="Text" ElementName="Root" />
                                    <Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Sections, ElementName=Root}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentTextBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource Tr}" Mode="OneWay">
                                                    <Binding Path="Header" />
                                                    <Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource Tr}" Mode="OneWay">
                                                    <Binding Path="Text" />
                                                    <Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l:T 'Esc para fechar'}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
