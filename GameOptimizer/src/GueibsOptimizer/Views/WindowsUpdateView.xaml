<UserControl x:Class="GueibsOptimizer.Views.WindowsUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
             xmlns:c="clr-namespace:GueibsOptimizer.Views.Controls"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:T 'Abrir o Windows Update'}" Command="{Binding OpenSettingsCommand}" VerticalAlignment="Top" />
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Windows Update'}" />
                        <c:InfoButton Title="{l:T 'Windows Update'}" Margin="4,0,0,0" VerticalAlignment="Center"
                                      Text="{l:T 'Ficar sem atualizações deixa o PC exposto a falhas de segurança já corrigidas pela Microsoft. Por isso o app não oferece desativar o Windows Update de vez. Somente segurança adia só as atualizações de recursos (versões novas do Windows) por 365 dias usando a política oficial DeferFeatureUpdatesPeriodInDays. Pausar usa os mesmos valores do app Configurações, com limite de 35 dias. Tudo pode ser desfeito.'}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SubtitleText}" Text="{l:T 'Escolha um modo seguro. As atualizações de segurança nunca são desligadas de vez.'}" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Text="{l:T 'Modo atual'}" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" AutomationProperties.Name="Modo atual do Windows Update" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="CurrentText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                    <TextBlock FontSize="12.5" Margin="0,6,0,0">
                        <Run Text="{l:T 'Última atualização instalada:'}" Foreground="{DynamicResource TextMutedBrush}" /><Run Text=" " /><Run><Run.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="LastUpdateText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></Run.Text></Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <UniformGrid Columns="3" Margin="-8,16,-8,0">
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="{l:T 'Usar o padrão'}" Command="{Binding ApplyCommand}" CommandParameter="default" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{l:T 'Padrão'}" />
                            <TextBlock Style="{StaticResource SubtitleText}" FontSize="12" Text="{l:T 'Remove as políticas e a pausa colocadas pelo app. O Windows atualiza como de costume.'}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0" BorderThickness="1" BorderBrush="{DynamicResource SuccessBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="{l:T 'Usar somente segurança'}" Command="{Binding ApplyCommand}" CommandParameter="security" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{l:T 'Somente segurança (recomendado)'}" />
                            <TextBlock Style="{StaticResource SubtitleText}" FontSize="12" Text="{l:T 'Adia as atualizações de recursos por 365 dias. As de segurança e qualidade continuam chegando.'}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                            <ComboBox ItemsSource="{Binding PauseOptions}" SelectedItem="{Binding PauseDays}" Width="70" Margin="0,0,8,0" AutomationProperties.Name="Dias de pausa" />
                            <Button Content="{l:T 'Pausar'}" Command="{Binding ApplyCommand}" CommandParameter="pause" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{l:T 'Pausar por até 35 dias'}" />
                            <TextBlock Style="{StaticResource SubtitleText}" FontSize="12" Text="{l:T 'Pausa todas as atualizações pelo número de dias escolhido. Depois o Windows volta a atualizar sozinho.'}" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="PauseEndText" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <WrapPanel Margin="0,16,0,0">
                <Button Content="{l:T 'Desfazer as mudanças do app'}" Command="{Binding RestoreCommand}" Margin="0,0,12,0" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Status" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
