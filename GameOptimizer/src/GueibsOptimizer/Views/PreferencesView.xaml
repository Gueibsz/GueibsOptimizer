<UserControl x:Class="GueibsOptimizer.Views.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
             xmlns:c="clr-namespace:GueibsOptimizer.Views.Controls"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="{l:T 'Reiniciar o Explorer agora'}" Command="{Binding RestartExplorerCommand}" AutomationProperties.Name="Reiniciar o Explorer agora" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,4,0,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="ExplorerStatus" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TitleText}" Text="{l:T 'Preferências'}" />
                        <c:InfoButton Title="{l:T 'Preferências'}" Margin="4,0,0,0" VerticalAlignment="Center"
                                      Text="{l:T 'Ajustes de gosto pessoal do Windows (Explorador, barra de tarefas, encaixe de janelas, tema). Não mudam o desempenho, não entram no Boost nem na pontuação. Cada um lê o estado real e pode ser desfeito. Alguns só aparecem depois de reiniciar o Explorer: use o botão ao lado quando quiser (o app nunca reinicia o Explorer sozinho). Itens do Windows 11 aparecem como não aplicáveis no Windows 10.'}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SubtitleText}" Text="{l:T 'Explorador, barra de tarefas, encaixe de janelas e tema. Só preferência: não mexe no desempenho.'}" />
                    <TextBlock Foreground="{DynamicResource AccentTextBrush}" FontSize="12" Margin="0,6,0,0" ><TextBlock.Text><MultiBinding Converter="{StaticResource Tr}" Mode="OneWay"><Binding Path="Items.Summary" Mode="OneWay" /><Binding Source="{x:Static l:LocalizationService.Instance}" Path="Version" /></MultiBinding></TextBlock.Text></TextBlock>
                </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Items.Items}" ItemTemplate="{StaticResource TweakCard}" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
