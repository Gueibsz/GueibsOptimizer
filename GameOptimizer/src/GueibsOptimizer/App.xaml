<Application x:Class="GueibsOptimizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GueibsOptimizer.Core"
             xmlns:m="clr-namespace:GueibsOptimizer.Models"
             xmlns:c="clr-namespace:GueibsOptimizer.Views.Controls"
             xmlns:v="clr-namespace:GueibsOptimizer.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Índice 0: paleta do tema (trocada em tempo de execução pelo ThemeService). -->
                <ResourceDictionary Source="Resources/Palette.Dark.xaml" />
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <v:InverseBoolConverter x:Key="InverseBool" />
            <v:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
            <v:ExeIconConverter x:Key="ExeIcon" />
            <l:TranslateConverter x:Key="Tr" />
            <!-- Cartão de um ajuste (ITweak): Otimização Completa e páginas por categoria. Fica aqui (e não num dicionário separado) para enxergar os estilos e conversores com StaticResource. -->
            <DataTemplate x:Key="TweakCard">
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                                        <c:InfoButton Title="{Binding Name}" Sections="{Binding InfoSections}" ShortTip="{l:T 'O que faz, o que altera, benefício, risco e como desfazer'}" />
                                                        <Border Margin="10,0,0,0" BorderThickness="1">
                                                            <Border.Style>
                                                                <!-- Cor por risco via gatilhos com DynamicResource: acompanha a troca de tema. -->
                                                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Risk}" Value="{x:Static m:TweakRisk.Low}">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Risk}" Value="{x:Static m:TweakRisk.Medium}">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding RiskText}" FontSize="11" />
                                                        </Border>
                                                        <TextBlock Text="{Binding PointsText}" Margin="10,0,0,0" FontSize="11"
                                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SubtitleText}" Margin="0,6,0,0" />
                                                    <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,6,0,0"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding Notice, Converter={StaticResource NotEmptyToVisibility}}" />
                                                    <TextBlock Text="{Binding OsRequirementText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                                               Visibility="{Binding OsRequirementText, Converter={StaticResource NotEmptyToVisibility}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" FontSize="12" Margin="0,0,0,8"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsApplicable}">
                                                        <Button Content="{Binding ApplyText}" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}"
                                                                Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                                                IsEnabled="{Binding CanInteract}" />
                                                        <Button Content="{l:T 'Desfazer'}" Style="{StaticResource DangerButton}" Command="{Binding RevertCommand}"
                                                                Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibility}}"
                                                                IsEnabled="{Binding CanInteract}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
            <v:EqualityConverter x:Key="EqualityConverter" />        </ResourceDictionary>
    </Application.Resources>
</Application>
